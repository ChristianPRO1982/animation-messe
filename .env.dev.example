# Copier vers .env.dev puis adapter les valeurs locales. Ne pas versionner .env.dev.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Europe/Paris

DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=carthographie
DB_USER=carthographie
DB_PASSWORD=change-me

AUTH_MODE=mock
AUTH_MOCK_BASE_URL=http://localhost:8001
AUTH_MOCK_SHARED_SECRET=change-me-dev-only
AUTH_MOCK_MAX_AGE_SECONDS=300
USER_SCHEMA=users
USER_TABLE=users
AUTH_MOCK_USERS_JSON='[{"label":"testmock (Admin)","external_id":"11111111-1111-1111-1111-111111111111","username":"testmock","email":"testmock@example.test","first_name":"Test","last_name":"Mock"}]'

# Email : ces valeurs sont utilisees par la surcharge optionnelle compose.email.yaml.
# La cle SMTP reste dans son fichier externe ; seul son chemin est indique ici.
AM_EMAIL_ENABLED=false
AM_PUBLIC_ORIGIN=http://localhost:8000
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=be2ae2001@smtp-brevo.com
DEFAULT_FROM_EMAIL=no-reply@animation-messe.fr
AM_EMAIL_FROM_NAME="Animation Messe"
AM_EMAIL_PLANNING_FROM_EMAIL=planning-noreply@animation-messe.fr
AM_EMAIL_PLANNING_FROM_NAME="Animation Messe - Planning"
BREVO_SMTP_SECRET_FILE=/chemin/absolu/hors-du-depot/cle-smtp-brevo.txt
